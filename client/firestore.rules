rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // Allow reading other users for admin functionality
      // Allow admins to list all users
      allow list: if isAdmin();
      
      // User subscriptions subcollection - users can read/write their own subscriptions
      match /subscriptions/{subscriptionId} {
        allow read, write, create, update: if request.auth != null && request.auth.uid == userId;
        allow list: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Projects - users can read/write their own, admins can read/write all
    match /projects/{projectId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }
    
    // Project requests - users can read/write their own, admins can read/write all  
    match /project-requests/{requestId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }
    
    // Project requests (with underscore) - users can read/write their own, admins can read/write all  
    match /project_requests/{requestId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }
    
    // Project features - users can read features for their own projects, admins can read/write all
    match /project_features/{featureId} {
      allow read, write: if request.auth != null && 
        (get(/databases/$(database)/documents/project_requests/$(resource.data.projectId)).data.userId == request.auth.uid || 
         isAdmin());
    }
    
    // User project requests - users can read/write their own, admins can read/write all
    match /user_project_requests/{requestId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.requestedBy || isAdmin());
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.requestedBy || isAdmin());
      allow list, read: if isAdmin();
    }
    
    // Admin projects - admins can read/write all, assigned users can read
    match /admin_projects/{projectId} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.assignedTo;
    }
    
    // Meetings - users can read/write their own, admins can read/write all
    match /meetings/{meetingId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Feature assignments - users can read/write their own, admins can read/write all
    match /feature-assignments/{assignmentId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Conversations - users can read/write conversations they participate in
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      allow create, write: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
    }
    
    // Messages - users can read/write messages in conversations they participate in
    match /messages/{messageId} {
      allow read: if request.auth != null && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null && 
        (request.resource.data.senderId == request.auth.uid || 
         request.resource.data.receiverId == request.auth.uid);
      allow update: if request.auth != null && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
    }
    
    // Notifications - users can read their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Chat system - allow authenticated users to read/write chats and messages
    match /chats/{chatId} {
      allow read, write, create, update: if request.auth != null;
        
      // Chat messages subcollection
      match /messages/{messageId} {
        allow read, create, update: if request.auth != null;
      }
    }
    
    // Feature requests - users can read/write their own, admins can read/write all
    match /feature_requests/{requestId} {
      allow read: if request.auth != null && 
        (resource.data.requestedBy == request.auth.uid || 
         isAdmin() ||
         // Allow users to read feature requests for their projects
         exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
         get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.userId == request.auth.uid);
      allow write: if request.auth != null && 
        (resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
        (request.resource.data.requestedBy == request.auth.uid || isAdmin());
      allow list: if request.auth != null; // Allow authenticated users to list and filter
    }
    
    // Feature assignments - users can read/write their own, admins can read/write all
    match /featureAssignments/{assignmentId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow list, read: if isAdmin();
    }
    
    // Conversation metadata - users can read/write their own, admins can read/write all
    match /conversation_metadata/{metadataId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow list, read: if isAdmin();
    }
    
    // AI conversations - users can read/write their own, admins can read/write all
    match /ai_conversations/{conversationId} {
      allow read, write: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow list, read: if isAdmin();
    }
    
    // UI design requests - users can read their own or those for projects they own; admins can read/write all
    match /ui_design_requests/{requestId} {
      allow read: if request.auth != null &&
        (
          // Request was created by the user
          resource.data.requestedBy == request.auth.uid ||
          // Admins can read all
          isAdmin() ||
          // Project owner can read requests for their project
          (
            resource.data.projectId != null &&
            exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
            get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.userId == request.auth.uid
          )
        );
      allow write: if request.auth != null &&
        (resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        (request.resource.data.requestedBy == request.auth.uid || isAdmin());
      // Allow authenticated users to run filtered list queries
      allow list: if request.auth != null;
    }
    
    // Subscriptions - users can read/write their own subscriptions, admins can read/write all
    match /subscriptions/{subscriptionId} {
      allow read, write, create, update: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if request.auth != null;
    }
    
    // Payments - users can read their own payment records; admins can read/write all
    match /payments/{paymentId} {
      // Allow users to read only their own payment records; admins can read any
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Writes are performed by server via Admin SDK; restrict client writes to admins only
      allow create, write, update: if isAdmin();
    }
    
    // Admin audit logs - admins can read/write, users cannot access
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
} 